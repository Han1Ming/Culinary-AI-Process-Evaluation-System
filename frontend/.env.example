# 环境变量样例
# ----------------------------------------------------------------------------
# 复制为 .env.development（开发）/ .env.production（生产）后按需修改。
# 只有 VITE_ 前缀的变量会被打进前端包，禁止在此写任何密钥。

# 站点标题
VITE_APP_TITLE=烹饪AI过程评价系统

# 后端接口前缀（必须带版本号）
# 开发：走 Vite devServer 代理，转发到 http://127.0.0.1:8000
# 生产：由 Nginx 把 /api 反代到 FastAPI；前后端不同域时写完整地址
#      如 https://api.example.edu.cn/api/v1
VITE_API_BASE_URL=/api/v1

# WebSocket 前缀（烹饪过程事件推送、四路画面状态）
VITE_WS_BASE_URL=/ws

# 是否启用前端 mock
#   开发环境可设 true，后端就绪后改 false
#   生产环境：即使写成 true 也会被 utils/env.ts 强制关闭，
#   且 production 构建会直接报错（除非同时设置 VITE_ALLOW_MOCK_IN_PROD=true）
VITE_USE_MOCK=false

# 仅答辩演示包使用：允许生产构建携带 mock 数据。正式上线必须删除或置 false。
# VITE_ALLOW_MOCK_IN_PROD=false
